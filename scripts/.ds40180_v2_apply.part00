#!/usr/bin/env python3
from __future__ import annotations

import base64
import compileall
import importlib
import json
import sys
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

def write(relative: str, content: str) -> None:
    path = ROOT / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    print(f"wrote {relative}")


def replace_once(relative: str, old: str, new: str) -> None:
    path = ROOT / relative
    text = path.read_text(encoding="utf-8")
    if old not in text:
        raise SystemExit(f"patch marker not found in {relative}: {old[:100]!r}")
    path.write_text(text.replace(old, new, 1), encoding="utf-8")
    print(f"patched {relative}")


def main() -> int:
    payload_path = ROOT / "scripts" / "ds40180_v2_payload.b85"
    packed = base64.b85decode(payload_path.read_bytes())
    files = json.loads(zlib.decompress(packed).decode("utf-8"))
    for relative, content in files.items():
        write(relative, content)


    replace_once(
        "src/finruntime/registry.py",
