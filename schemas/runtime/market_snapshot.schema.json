{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fin.local/schemas/runtime/market_snapshot.schema.json",
  "title": "MarketSnapshot",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "as_of_utc",
    "decision_time_utc",
    "sources",
    "spot",
    "perp",
    "funding_events",
    "onchain",
    "cash_rate",
    "quality_flags"
  ],
  "$defs": {
    "sourceObservation": {
      "type": "object",
      "$comment": "Runtime also enforces source_timestamp_utc <= available_at_utc <= decision_time_utc.",
      "required": ["source", "source_timestamp_utc", "available_at_utc", "payload_sha256", "quality"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "source_timestamp_utc": {"type": "string", "pattern": "Z$"},
        "available_at_utc": {"type": "string", "pattern": "Z$"},
        "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "quality": {"enum": ["ok", "stale", "missing", "future", "invalid"]}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "as_of_utc": {"type": "string", "pattern": "Z$"},
    "decision_time_utc": {"type": "string", "pattern": "Z$"},
    "sources": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sourceObservation"}},
    "spot": {"type": "object"},
    "perp": {"type": "object"},
    "funding_events": {"type": "array"},
    "onchain": {"type": "object"},
    "cash_rate": {"type": "object"},
    "quality_flags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
